# Copy to .env.local and fill in. Never commit real values.

# --- Supabase -------------------------------------------------------------
# Project URL and the browser-safe publishable (anon) key. These ship in the
# client bundle, so only public-safe tables are readable with them — see the
# grants block at the end of db/lms-schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Bypasses grants — never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Admin ----------------------------------------------------------------
# Password for /admin. The session cookie stores its SHA-256, not the password.
ADMIN_PASSWORD=

# --- Results cron (/api/cron/results) --------------------------------------
# Shared secret protecting the cron route. Sent as "Authorization: Bearer ..."
# (what Vercel Cron sends automatically) or an "x-cron-secret" header. NOT
# accepted as a query parameter — URLs leak into logs and browser history.
# Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# API-Football key (https://www.api-football.com) — free tier is enough, the
# job makes one call per run. Without this the cron reports an error and
# writes nothing.
API_FOOTBALL_KEY=
