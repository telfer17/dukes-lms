# Copy to .env.local and fill in. Never commit real values.

# --- Supabase -------------------------------------------------------------
# Project URL and the browser-safe publishable (anon) key. Both are
# NEXT_PUBLIC_ — treat them as public — so only public-safe tables are readable
# with them; see the grants block at the end of db/lms-schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Bypasses grants — never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Admin ----------------------------------------------------------------
# Password for /admin. The session cookie stores its SHA-256, not the password.
ADMIN_PASSWORD=
